from collections import defaultdict
from dataclasses import dataclass
import re
from time import time

from aqt import mw
from aqt.utils import showText

from .priority_score import get_ankiphil_deck_ids


RECENT_DAYS = 30
MIN_REVIEWS_PER_CARD = 3

# Technical/import/organisation tags that do not describe medical knowledge.
NOISE_PARTS = {
    "ankiphil", "ak", "amboss", "anki", "bws", "card", "cards", "cloze",
    "deck", "decks", "dope", "exam", "fa", "flag", "highyield", "image",
    "import", "karte", "karten", "lowyield", "markiert", "metadata", "m2",
    "notetype", "original", "semester", "source", "tag", "tags", "version",
    "vorklinik", "yield", "zankiphil", "hammer", "top100", "100tage",
    "lerntag", "lerntage", "priorität", "priority",
}
NOISE_PATTERNS = (
    re.compile(r"^\d+$"),
    re.compile(r"^v?\d+(?:[._-]\d+)*$", re.IGNORECASE),
    re.compile(r"^[0-9a-f]{8,}$", re.IGNORECASE),
    re.compile(r"^(?:20)?\d{2}[-_.]\d{1,2}(?:[-_.]\d{1,2})?$"),
)


@dataclass
class WeaknessTopic:
    topic: str
    cards: int
    reviews: int
    again_count: int
    recent_again: int
    weakness_score: float

    @property
    def again_rate(self):
        return self.again_count / self.reviews if self.reviews else 0.0


def _display_name(value):
    value = re.sub(r"[_-]+", " ", value).strip()
    return value[:1].upper() + value[1:] if value else value


MEDICAL_SUBJECTS = {
    "allgemeinmedizin", "anästhesiologie", "anästhesie", "arbeitsmedizin",
    "augenheilkunde", "chirurgie", "dermatologie", "endokrinologie",
    "gastroenterologie", "geriatrie", "gynäkologie", "hämatologie und onkologie",
    "hno", "hals nasen ohren heilkunde", "immunologie", "infektiologie",
    "innere medizin", "intensivmedizin", "kardiologie", "kinderchirurgie",
    "medizinische genetik", "nephrologie", "neurologie", "neurochirurgie",
    "notfallmedizin", "nuklearmedizin", "onkologie", "orthopädie",
    "pathologie", "pädiatrie", "pharmakologie", "pneumologie", "psychiatrie",
    "psychosomatik", "radiologie", "rechtsmedizin", "rheumatologie",
    "strahlentherapie", "urologie",
}


def _normalized(value):
    return re.sub(r"[_!#-]+", " ", value).strip().casefold()


def _meaningful_parts(tag):
    parts = [part.strip() for part in tag.split("::") if part.strip()]
    candidates = []
    for part in parts:
        normalized = _normalized(part)
        compact = re.sub(r"[^\wäöüß]+", "", normalized)
        if len(compact) < 3 or normalized in NOISE_PARTS or compact in NOISE_PARTS:
            continue
        if any(pattern.fullmatch(compact) for pattern in NOISE_PATTERNS):
            continue
        candidates.append(part)
    return candidates


def _classify_tag(tag):
    """Return a (subject, specific topic) pair from one hierarchical tag."""
    parts = _meaningful_parts(tag)
    if not parts:
        return None, None

    subject = next(
        (_display_name(part) for part in parts if _normalized(part) in MEDICAL_SUBJECTS),
        None,
    )
    topic = _display_name(parts[-1])
    if subject and _normalized(topic) == _normalized(subject):
        topic = None
    return subject, topic


def _card_review_rows():
    deck_ids = get_ankiphil_deck_ids()
    if not deck_ids:
        return []
    placeholders = ",".join(["?"] * len(deck_ids))
    recent_cutoff = int((time() - RECENT_DAYS * 86400) * 1000)
    return mw.col.db.all(
        f"""
        SELECT cards.nid, revlog.cid, COUNT(*),
               SUM(CASE WHEN revlog.ease = 1 THEN 1 ELSE 0 END),
               SUM(CASE WHEN revlog.ease = 1 AND revlog.id >= ? THEN 1 ELSE 0 END)
        FROM revlog
        INNER JOIN cards ON cards.id = revlog.cid
        WHERE revlog.ease > 0
          AND (CASE WHEN cards.odid != 0 THEN cards.odid ELSE cards.did END)
              IN ({placeholders})
        GROUP BY revlog.cid
        HAVING COUNT(*) >= ?
        """,
        recent_cutoff,
        *deck_ids,
        MIN_REVIEWS_PER_CARD,
    )


def _calculate_weakness(level, limit):
    aggregates = defaultdict(lambda: {"card_ids": set(), "reviews": 0, "again": 0, "recent": 0})
    for note_id, card_id, reviews, again_count, recent_again in _card_review_rows():
        note = mw.col.get_note(note_id)
        values = set()
        for tag in note.tags:
            subject, topic = _classify_tag(tag)
            value = subject if level == "subject" else topic
            if value:
                values.add(value)
        for value in values:
            item = aggregates[value]
            item["card_ids"].add(card_id)
            item["reviews"] += reviews
            item["again"] += again_count or 0
            item["recent"] += recent_again or 0

    results = []
    for value, data in aggregates.items():
        reviews = data["reviews"]
        rate = data["again"] / reviews if reviews else 0.0
        # Rate is central; repeated and recent failures add urgency without allowing
        # huge topics to dominate purely because they contain more cards.
        score = rate * 70 + min(data["again"], 10) * 2 + min(data["recent"], 6) * 3
        results.append(
            WeaknessTopic(value, len(data["card_ids"]), reviews, data["again"], data["recent"], score)
        )
    results.sort(key=lambda item: (item.weakness_score, item.reviews), reverse=True)
    return results[:limit]


def calculate_weakness_subjects(limit=10):
    return _calculate_weakness("subject", limit)


def calculate_weakness_topics(limit=10):
    return _calculate_weakness("topic", limit)


def get_weakness_summary(limit=3):
    subjects = calculate_weakness_subjects(limit=limit)
    topics = calculate_weakness_topics(limit=limit)
    if not subjects and not topics:
        return "Noch keine auswertbaren Themen gefunden."
    lines = []
    if subjects:
        lines.append("Fächer: " + " • ".join(item.topic for item in subjects))
    if topics:
        lines.append("Themen: " + " • ".join(item.topic for item in topics))
    return "\n".join(lines)


def _ranking_lines(items):
    lines = []
    for position, item in enumerate(items, start=1):
        lines.extend(
            [
                f"{position}. {item.topic} – Score {item.weakness_score:.1f}",
                f"   {item.cards} Karten | {item.reviews} Reviews | "
                f"Again {item.again_count} ({item.again_rate:.0%}) | Again 30d {item.recent_again}",
                "",
            ]
        )
    return lines


def show_weakness_radar():
    subjects = calculate_weakness_subjects(limit=10)
    topics = calculate_weakness_topics(limit=15)
    if not subjects and not topics:
        showText(
            "AnkiMed konnte keine auswertbaren Ankiphil-Themen finden.\n\n"
            "Benötigt werden Notiz-Tags und mindestens drei Reviews pro Karte."
        )
        return
    lines = ["ANKIMED – WEAKNESS RADAR", ""]
    if subjects:
        lines.extend(["SCHWÄCHSTE FACHGEBIETE", ""])
        lines.extend(_ranking_lines(subjects))
    if topics:
        lines.extend(["SCHWÄCHSTE KONKRETE THEMEN", ""])
        lines.extend(_ranking_lines(topics))
    showText("\n".join(lines))
